// ==========================================
// PLUX MAX ENTERPRISE ERP - PRISMA SCHEMA
// ==========================================
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------
// 1. SUPER ADMIN & MULTI-TENANCY
// ------------------------------------------
enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  ARCHIVED
}

model Tenant {
  id           String       @id @default(uuid())
  name         String
  code         String       @unique
  domain       String?      @unique
  status       TenantStatus @default(TRIAL)
  logoUrl      String?
  config       Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users         User[]
  roles         Role[]
  departments   Department[]
  patients      Patient[]
  students      Student[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

model Subscription {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planName     String
  maxBeds      Int      @default(100)
  maxStudents  Int      @default(500)
  maxUsers     Int      @default(1000)
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("subscriptions")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  userId    String?
  action    String
  resource  String
  payload   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ------------------------------------------
// 2. AUTHENTICATION & RBAC
// ------------------------------------------
enum UserType {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  NURSE
  STAFF
  STUDENT
  FACULTY
  PATIENT
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  userType     UserType
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  mfaSecret    String?
  isMfaEnabled Boolean   @default(false)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userRoles    UserRole[]
  doctor       DoctorProfile?
  student      Student?
  faculty      Faculty?
  patient      Patient?
  employee     Employee?

  @@unique([tenantId, email])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  description String?

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ------------------------------------------
// 3. PUBLIC WEBSITE & CLINICAL DEPARTMENTS
// ------------------------------------------
model Department {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  isAcademic  Boolean  @default(false)
  isClinical  Boolean  @default(true)
  createdAt   DateTime @default(now())

  doctors     DoctorProfile[]
  wards       Ward[]
  courses     Course[]

  @@unique([tenantId, code])
  @@map("departments")
}

model DoctorProfile {
  id              String     @id @default(uuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  specialization  String
  qualification   String
  licenseNumber   String     @unique
  consultationFee Decimal    @db.Decimal(10, 2)
  experienceYears Int        @default(0)
  bio             String?

  appointments    Appointment[]
  prescriptions   Prescription[]
  opdRecords      OpdRecord[]
  ipdAdmissions   Admission[]

  @@map("doctor_profiles")
}

// ------------------------------------------
// 4. CORE HOSPITAL ERP (PATIENT, WARD, ADMISSION)
// ------------------------------------------
enum Gender {
  MALE
  FEMALE
  OTHER
}

model Patient {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId           String?   @unique
  user             User?     @relation(fields: [userId], references: [id])
  uhid             String    @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  gender           Gender
  bloodGroup       String?
  phone            String
  address          String?
  emergencyContact String?
  nationalId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointments  Appointment[]
  admissions    Admission[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  invoices      Invoice[]
  triages       TriageRecord[]

  @@map("patients")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          DoctorProfile     @relation(fields: [doctorId], references: [id])
  appointmentTime DateTime
  status          AppointmentStatus @default(SCHEDULED)
  reason          String?
  tokenNumber     Int?
  createdAt       DateTime          @default(now())

  @@map("appointments")
}

model Ward {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  name         String
  type         String
  totalBeds    Int

  beds         Bed[]

  @@map("wards")
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

model Bed {
  id        String    @id @default(uuid())
  wardId    String
  ward      Ward      @relation(fields: [wardId], references: [id])
  bedNumber String
  status    BedStatus @default(AVAILABLE)

  admissions Admission[]

  @@map("beds")
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
}

model Admission {
  id           String          @id @default(uuid())
  patientId    String
  patient      Patient         @relation(fields: [patientId], references: [id])
  doctorId     String
  doctor       DoctorProfile   @relation(fields: [doctorId], references: [id])
  bedId        String
  bed          Bed             @relation(fields: [bedId], references: [id])
  admittedAt   DateTime        @default(now())
  dischargedAt DateTime?
  status       AdmissionStatus @default(ADMITTED)
  diagnosis    String?

  @@map("admissions")
}

model OpdRecord {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])
  symptoms  String
  diagnosis String
  icdCode   String?
  vitals    Json?
  createdAt DateTime      @default(now())

  @@map("opd_records")
}

// ------------------------------------------
// 5. CLINICAL & DIAGNOSTICS
// ------------------------------------------
model PharmacyItem {
  id           String   @id @default(uuid())
  name         String
  category     String
  sku          String   @unique
  batchNumber  String
  expiryDate   DateTime
  unitPrice    Decimal  @db.Decimal(10, 2)
  stockQty     Int
  reorderLevel Int      @default(10)

  prescriptionItems PrescriptionItem[]

  @@map("pharmacy_items")
}

model Prescription {
  id           String        @id @default(uuid())
  patientId    String
  patient      Patient       @relation(fields: [patientId], references: [id])
  doctorId     String
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id])
  instructions String?
  createdAt    DateTime      @default(now())

  items        PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  itemId         String
  item           PharmacyItem @relation(fields: [itemId], references: [id])
  dosage         String
  durationDays   Int
  quantity       Int

  @@map("prescription_items")
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model LabOrder {
  id        String      @id @default(uuid())
  patientId String
  patient   Patient     @relation(fields: [patientId], references: [id])
  testName  String
  category  String
  status    OrderStatus @default(PENDING)
  result    String?
  reportUrl String?
  createdAt DateTime    @default(now())

  @@map("lab_orders")
}

// ------------------------------------------
// 6. FINANCIAL ERP
// ------------------------------------------
enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Invoice {
  id            String        @id @default(uuid())
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  invoiceNumber String        @unique
  totalAmount   Decimal       @db.Decimal(12, 2)
  gstAmount     Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(UNPAID)
  createdAt     DateTime      @default(now())

  payments      Payment[]
  items         InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  description String
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  amount      Decimal  @db.Decimal(10, 2)

  @@map("invoice_items")
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Decimal  @db.Decimal(10, 2)
  paymentMode   String
  transactionId String?
  paidAt        DateTime @default(now())

  @@map("payments")
}

// ------------------------------------------
// 7. ACADEMIC (MEDICAL COLLEGE) ERP
// ------------------------------------------
model Student {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber      String   @unique
  batchYear       Int
  courseName      String
  currentYear     Int
  currentSemester Int

  enrollments     Enrollment[]
  postings        ClinicalPosting[]
  examResults     ExamResult[]

  @@map("students")
}

model Faculty {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation String
  department  String

  courses     Course[]

  @@map("faculties")
}

model Course {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  facultyId    String?
  faculty      Faculty?   @relation(fields: [facultyId], references: [id])
  code         String     @unique
  title        String
  credits      Int

  enrollments  Enrollment[]

  @@map("courses")
}

model Enrollment {
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])

  @@id([studentId, courseId])
  @@map("enrollments")
}

model ClinicalPosting {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  wardName  String
  startDate DateTime
  endDate   DateTime
  evalScore Decimal? @db.Decimal(4, 2)
  status    String   @default("ASSIGNED")

  @@map("clinical_postings")
}

model ExamResult {
  id            String  @id @default(uuid())
  studentId     String
  student       Student @relation(fields: [studentId], references: [id])
  subject       String
  marksObtained Decimal @db.Decimal(5, 2)
  maxMarks      Decimal @db.Decimal(5, 2)
  grade         String

  @@map("exam_results")
}

// ------------------------------------------
// 8. HR & ADMIN
// ------------------------------------------
model Employee {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String   @unique
  designation  String
  joiningDate  DateTime
  salaryBase   Decimal  @db.Decimal(12, 2)

  attendances  Attendance[]

  @@map("employees")
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String

  @@map("attendances")
}

// ------------------------------------------
// 9. AI & PREDICTIVE ANALYTICS
// ------------------------------------------
model TriageRecord {
  id            String   @id @default(uuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  vitals        Json
  symptomsText  String
  aiTriageScore String
  confidence    Float
  suggestedICD  String?
  createdAt     DateTime @default(now())

  @@map("triage_records")
}
